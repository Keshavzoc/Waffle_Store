{
  "name": "waffle-poll",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=18" },
  "scripts": {
    "setup": "npm --prefix client install && npm --prefix server install",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "build:prod": "npm --prefix client install && npm --prefix client run build && npm --prefix server install",
    "start": "node server/index.js",
    "start:prod": "node server/index.js",
    "sheet:check": "npm --prefix server run check"
  }
}
