PORT=5000
# Your Google Apps Script Web App link (ends with /exec)
SHEETS_WEBHOOK_URL=
# Secret word to see totals at /api/stats?key=YOUR_WORD
ADMIN_KEY=Waffle_Admin
# Set to 1 when hosted behind a proxy (Render, Railway, Nginx, Cloudflare...)
TRUST_PROXY=1
# Max votes from one IP in 10 minutes (keep high for shared college Wi-Fi)
RATE_LIMIT=3000
# Extra photo websites allowed on the page, separated by commas
IMG_HOSTS=

